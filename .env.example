# Copy to .env before running: cp .env.example .env

# Postgres connection string used by SQLAlchemy and Alembic.
# Host is the docker-compose service name when running in Compose.
DATABASE_URL=postgresql+psycopg2://justdial:justdial@postgres:5432/justdial_ca

# Redis connection string (Celery broker / result backend later).
REDIS_URL=redis://redis:6379/0

# App secret — replace with a long random value.
SECRET_KEY=change-me-to-a-long-random-string

# Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Outbound email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=change-me

# development | staging | production
ENVIRONMENT=development

# --- Object storage (MinIO locally) ---
# Endpoint the backend/worker use to reach MinIO.
MINIO_ENDPOINT=http://minio:9000
# Endpoint baked into presigned URLs; must be browser-reachable.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_VIDEOS=justdial-videos
# KYC licence and GST documents. A separate bucket from the videos so a
# retention rule on one cannot sweep the other.
MINIO_BUCKET_DOCUMENTS=kyc-documents

# --- Malware scanning (ClamAV) ---
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- Encryption at rest ---
# MinIO built-in KMS key enabling SSE-S3. Format: <key-name>:<base64 32 bytes>.
# Generate with: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
MINIO_KMS_SECRET_KEY=justdial-videos-key:REPLACE_WITH_BASE64_32_BYTES

# --- Payments (Stripe) ---
# Blank = stub mode, which is the default and is fully working: /plans,
# /subscriptions/checkout and /webhooks/stripe all respond, subscription rows
# are created and move through their states, and no money is involved. Fill
# these in to switch to the real gateway - nothing else changes.
# See app/services/payment_gateway.py for the stripe.* call each stub replaces.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Where the gateway returns the customer when the API caller does not say.
STRIPE_SUCCESS_URL=http://localhost:3001/dashboard?checkout=success
STRIPE_CANCEL_URL=http://localhost:3001/dashboard?checkout=cancelled
